{
  "name": "realtalk-sdk",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "embed-demo": "turbo build --filter @realtalk-ai/embed && http-server . -a 127.0.0.1 -p 4173 -c-1",
    "format": "prettier --write .",
    "prepare": "husky",
    "release": "pnpm install && pnpm build && changeset publish"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "prettier": "^3.8.1",
    "turbo": "^2.8.0",
    "typescript": "^5.9.3"
  }
}
